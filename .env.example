# --- Villa finance test stack (defaults avoid reflexive: :3000/:3001, Postgres 5433) ---

COMPOSE_PROJECT_NAME=villa-finance

# Web UI (nginx). Reflexive uses 3000/3001; this stack uses 8080 by default.
HTTP_PORT=8080
# API on host (browser calls this directly — nginx /api not required)
API_PORT=4002
# Rebuild web after change: docker compose up --build -d web
# NEXT_PUBLIC_API_URL=http://62.238.60.74:4002/api
NEXT_PUBLIC_API_URL=http://localhost:4002/api
# Origin of the dashboard (for CORS)
CORS_ORIGIN=http://localhost:8080
# Server example:
# CORS_ORIGIN=http://62.238.60.74:8080
# NEXT_PUBLIC_API_URL=http://62.238.60.74:4002/api

# PostgreSQL (host bind 127.0.0.1 only — reflexive uses 5433)
POSTGRES_USER=villa
POSTGRES_PASSWORD=villa_secret
POSTGRES_DB=villa_finance
POSTGRES_PORT=5434

# Inside compose, API uses service name postgres:5432
DATABASE_URL=postgresql://villa:villa_secret@postgres:5432/villa_finance

DATA_DIR=/app/data
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# AI assistant (optional — without key, offline summary from DB tools)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1

# Redis (optional profile: docker compose --profile full up -d)
REDIS_URL=redis://redis:6379

# --- Local dev without Docker (Postgres in villa-finance container on 5434) ---
# DATABASE_URL=postgresql://villa:villa_secret@127.0.0.1:5434/villa_finance
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
# CORS_ORIGIN=http://localhost:3000
